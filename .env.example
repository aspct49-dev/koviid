# Roobet affiliate stats API.
# Issued with the affiliate account. ROOBET_USER_ID is the `id` claim inside
# the API key's JWT payload — the two must belong to the same account or the
# endpoint returns an empty board rather than an error.
ROOBET_USER_ID=
ROOBET_API_KEY=

# Canonical origin, e.g. https://koviid.me
NEXT_PUBLIC_SITE_URL=
